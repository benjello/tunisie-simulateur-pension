# Modèle de configuration locale. Copie ce fichier en `.env` (gitignoré) et
# remplis les valeurs. Sert à propager les secrets shinyapps.io vers les repos
# via scripts/set_shinyapps_secrets.sh.
#
#   cp .env.example .env && chmod 600 .env   # puis éditer .env

SHINYAPPS_ACCOUNT=benjello
SHINYAPPS_TOKEN=
SHINYAPPS_SECRET=
